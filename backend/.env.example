# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME

# Supabase Postgres (async driver — keep the +asyncpg suffix)
# Example: postgresql+asyncpg://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# Upstash Redis (rediss:// for TLS, redis:// for plain)
# Example: rediss://default:PASSWORD@REGION.upstash.io:6379
REDIS_URL=rediss://default:REPLACE_ME@REPLACE_ME.upstash.io:6379

# Semantic cache tuning (defaults shown)
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL_SECONDS=86400

# Langfuse Cloud (https://cloud.langfuse.com) or self-hosted
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
